        <mxCell id="admin2" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b5739d;fontColor=#652b49;" value="Admin PC2 | VLAN 30&#xa;IP: TBD" vertex="1">
